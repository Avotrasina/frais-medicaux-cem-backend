<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<title>Attestation de prise en charge</title>
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
<style>
@page { size: A4; margin: 0; }
html, body { margin: 0; padding: 0; }
.page { font-family: Cambria, "Times New Roman", Georgia, serif; }
* { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
</style>
</head>
<body>
<div class="page w-[210mm] h-[296mm] bg-white text-black pt-[22mm] px-[18mm] overflow-hidden">

  <div id="header" class="flex flex-row justify-between">
    <div class="pt-4 flex flex-col">
      <div id="cem-introduction" class="flex flex-col items-center w-[100mm]">
        <img src="{{logoCem}}" alt="cem logo" class="h-16 w-48" />
        <h3 class="text-sm font-bold text-center leading-6 mt-3">
          DIRECTION DES RESSOURCES HUMAINES <br />
          Service des Affaires Sociale <br />
          et Communication Interne
        </h3>
      </div>

      <h1 class="font-semibold text-lg leading-8 mt-16">
        ATTESTATION DE PRISE EN CHARGE <br />
        <i>Réf : {{reference}}</i> <br />
        Code patient : {{idp}}
      </h1>
    </div>

    <div id="image_carte" class="h-84 w-64 shrink-0 bg-gray-300 border-gray-300 rounded-2xl overflow-hidden">
      {{#if image}}
      <img src="{{image}}" alt="photo" class="w-full h-full object-cover" />
      {{/if}}
    </div>
  </div>

  {{#if (eq codeFamille "AGENT")}}
  {{> agent}}
  {{else}}
  {{> famille}}
  {{/if}}

  <p class="mt-[18mm] pl-[95mm] text-base">{{agent.localite}}, le {{date}}</p>

</div>
</body>
</html>