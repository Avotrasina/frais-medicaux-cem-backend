FACTURATION_UTILISATEUR_TEST_ID=9001
FACTURATION_UTILISATEUR_ADJOINT_TEST_ID=9002
FACTURATION_UTILISATEUR_CHEF_TEST_ID=9003
FACTURATION_REGLE_ACTIF_TEST_ID=9004
FACTURATION_REGLE_NON_ACTIF_TEST_ID=9005
ALLOW_DEMO_SEED=true
# ===================================================
# Configuration de la base de données
# Copier ce fichier en .env et adapter les valeurs :
#   cp .env.example .env
# ===================================================

# --- Variables lues par l'image PostgreSQL ---
# Obligatoires avec le Dev Container (docker-compose).
# Ignorées si Postgres tourne en dehors de Docker.
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database

# --- Variables lues par NestJS ---
# Toujours nécessaires.
# NODE_ENV accepte development ou production (development par défaut).
NODE_ENV=development
PERMISSIONS_ROLES_ACTIVES=false
# DB_HOST=db : nom du service dans docker-compose.
# Hors Dev Container, utiliser localhost (ou l'adresse de ton serveur).
DB_HOST=db #ou localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password

STORAGE_ROOT=data
UPLOAD_MAX_IMAGE_SIZE=2097152
UPLOAD_MAX_PDF_SIZE=10485760
STORAGE_IMAGES_DIR=images
STORAGE_CARTES_PROFESSIONNELLES_DIR=cartes-professionnelles
STORAGE_CARTES_SOCIALES_DIR=cartes-sociales
STORAGE_PDF_DIR=pdf
STORAGE_PDF_ATTESTATION_DIR=attestations
STORAGE_PDF_CONVENTION_DIR=conventions

## Transaction Configuration for the puppeteer
TRANSACTION_MAX_WAIT= 
TRANSACTION_TIMEOUT=
