model Direction {
  codeDirection String    @id @map("code_direction")
  nom           String
  services      Service[]

  structure StructureOrganisationnelle @relation(fields: [codeDirection], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("directions")
  @@schema("personnel")
}

model Service {
  codeService   String @id @map("code_service")
  nom           String
  codeDirection String @map("code_direction")

  direction Direction @relation(fields: [codeDirection], references: [codeDirection])

  agents Agent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("services")
  @@schema("personnel")
}
