model Beneficiaire {
  id                Int                @id
  idp               String             @unique @map("idp")
  observationIDP    String?            @map("observation_idp")
  suppressionStatut SuppressionStatut?
  attestations      Attestation[]

  personne Personne @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("beneficiaires")
  @@schema("pec")
}
