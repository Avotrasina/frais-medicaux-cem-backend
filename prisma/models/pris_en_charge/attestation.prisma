enum StatutAttestation {
  EN_ATTENTE @map("en_attente")
  VALIDEE    @map("validee")
  REFUSEE    @map("refusee")

  @@map("statut_attestation")
  @@schema("pec")
}

model Attestation {
  id                 Int               @id @default(autoincrement())
  attestationPath    String?           @map("attestation_path") @db.VarChar(50)
  dateValidation     DateTime?         @map("dt_validation")
  naturePrestation   String            @map("nature_prestation") @db.VarChar(100)
  servicePrestataire String?           @map("service_prestataire") @db.VarChar(50)
  statut             StatutAttestation @default(EN_ATTENTE)

  prestataireID   Int    @map("prestataire_id")
  idpBeneficiaire String @map("beneficiaire_id")

  prestataire  Prestataire  @relation(fields: [prestataireID], references: [id])
  beneficiaire Beneficiaire @relation(fields: [idpBeneficiaire], references: [idp])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("attestations")
  @@schema("pec")
}
