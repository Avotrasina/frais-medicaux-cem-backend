enum StatutPrestataire {
  PRIVE  @map("privee")
  PUBLIC @map("public")

  @@map("statut_prestataire")
  @@schema("pec")
}

model Prestataire {
  id                  Int               @id @default(autoincrement())
  nom                 String
  adresse             String
  statut              StatutPrestataire @map("status_prestataire")
  nif                 String            @unique
  stat                String            @unique
  dateDebutConvention DateTime          @map("dt_debut_convention")
  dateFinConvention   DateTime          @map("dt_fin_convention")
  listePrestation     String            @map("liste_prestation")

  attestations Attestation[]
  conventions  Convention[]

  lieuID      Int @map("lieu_id")
  categorieID Int @map("categorie_id")

  lieu      Lieu                 @relation(fields: [lieuID], references: [id])
  categorie CategoriePrestataire @relation(fields: [categorieID], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("prestataires")
  @@schema("pec")
}

model Lieu {
  id  Int    @id @default(autoincrement())
  nom String @map("nom")

  prestataires Prestataire[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("lieux")
  @@schema("pec")
}

model CategoriePrestataire {
  id  Int    @id @default(autoincrement())
  nom String @map("nom")

  prestataires Prestataire[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("categories_prestataire")
  @@schema("pec")
}

model Convention {
  id             Int    @id @default(autoincrement())
  conventionPath String @map("convention_path")
  idPrestataire  Int    @map("id_prestataire")

  presatataire Prestataire @relation(fields: [idPrestataire], references: [id])

  @@map("conventions")
  @@schema("pec")
}
