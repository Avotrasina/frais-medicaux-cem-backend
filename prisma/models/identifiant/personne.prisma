enum Sexe {
  MASCULIN @map("masculin")
  FEMININ  @map("feminin")

  @@map("sexe")
  @@schema("identifiant")
}

model Personne {
  id                Int                @id @default(autoincrement())
  nom               String             @db.VarChar(25)
  prenom            String             @db.VarChar(100)
  dateNaissance     DateTime           @map("dt_naissance")
  sexe              Sexe
  suppressionStatut SuppressionStatut?

  beneficiaire Beneficiaire?
  familleAgent FamilleAgent?
  agent        Agent?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("personnes")
  @@schema("identifiant")
}
