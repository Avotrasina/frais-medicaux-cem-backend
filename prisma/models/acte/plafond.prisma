enum PorteePlafond {
  PAR_ACTE @map("par_acte")
  PAR_AN   @map("par_an")

  @@map("portee_plafond")
  @@schema("acte")
}

enum UnitePlafond {
  MONTANT @map("montant")
  SEANCES @map("seances")

  @@map("unite_plafond")
  @@schema("acte")
}

model Plafond {
  id              Int           @id @default(autoincrement())
  porteePlafond   PorteePlafond @default(PAR_ACTE)
  unite           UnitePlafond  @default(MONTANT)
  montant         Decimal?      @db.Decimal(15, 2)
  nbSeances       Int?
  acteID          Int?          @map("acte_id")
  categorieActeID Int?          @map("categorie_acte_id")

  acte          Acte?          @relation(fields: [acteID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categorieActe CategorieActe? @relation(fields: [categorieActeID], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([acteID, porteePlafond])
  @@unique([categorieActeID, porteePlafond])
  @@map("plafonds")
  @@schema("acte")
}
